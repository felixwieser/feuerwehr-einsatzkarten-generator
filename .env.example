# Kopiere diese Datei zu ".env" und trage eure echten Werte ein:
#   cp .env.example .env

# --- Klartext-Anfahrtsbeschreibung: KI oder regelbasiert? ---
# "deterministic" (Standard): regelbasiert ohne KI (siehe
# src/lib/deterministicDescription.ts) - kostenlos, kein Halluzinations-
# Risiko, aber ein paar Feinheiten (z. B. benannte Kreuzungen wie "am
# Isartorplatz") fehlen, siehe Kommentar dort. Ollama/Anthropic werden in
# diesem Modus gar nicht aufgerufen.
# "ai": KI-Übersetzung (Ollama + Anthropic-Rückfallebene, siehe unten) -
# bestes Textgefühl, kostet aber pro Karte etwas (wenn auf Anthropic
# zurückgefallen wird).
DESCRIPTION_MODE=deterministic

# --- Ollama (primärer LLM-Provider für die Anfahrtsbeschreibung, nur bei DESCRIPTION_MODE=ai) ---
# Euer eigener/lokaler Ollama-Server (https://ollama.com) - läuft komplett
# bei euch, kein API-Key nötig. Modell vorher einmalig laden: "ollama pull
# llama3.1" (oder ein anderes Modell eurer Wahl, dann OLLAMA_MODEL anpassen).
# Ist Ollama nicht erreichbar oder schlägt fehl, weicht die App automatisch
# auf Anthropic Claude aus (siehe unten) - ANTHROPIC_API_KEY bleibt daher
# trotzdem Pflicht.
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Wartezeit in Millisekunden, bevor bei einer Ollama-Anfrage aufgegeben und
# auf Anthropic ausgewichen wird.
OLLAMA_TIMEOUT_MS=15000

# --- Anthropic Claude API (Pflicht - Rückfallebene, falls Ollama fehlschlägt) ---
# API-Key erhaltet ihr unter https://console.anthropic.com/ (Account
# anlegen -> "API Keys" -> "Create Key"). Achtung: dort muss zusätzlich
# Guthaben/eine Zahlungsmethode hinterlegt sein, siehe README.
ANTHROPIC_API_KEY=sk-ant-hier-euren-key-eintragen

# Welches Claude-Modell für die Anfahrtsbeschreibung genutzt wird.
# Modellnamen ändern sich mit der Zeit - prüft im Zweifel die aktuell
# gültigen Modellnamen unter https://docs.anthropic.com/ (Stichwort
# "Models"). Der hier hinterlegte Wert war zum Erstellungszeitpunkt aktuell.
ANTHROPIC_MODEL=claude-sonnet-5

# --- openrouteservice (Routing) ---
# API-Key unter https://openrouteservice.org/dev/#/signup (kostenlos,
# Standard-Plan reicht: 2000 Anfragen/Tag). Genutzt wird das normale
# "driving-car"-Profil (nicht "driving-hgv"), siehe Kommentar in
# src/lib/config.ts für die Begründung.
ORS_API_KEY=eure-ors-api-key-hier-eintragen
ORS_URL=https://api.openrouteservice.org

# Höhe (in Metern) des größten Einsatzfahrzeugs - wird genutzt, um Routen
# gezielt an zu niedrigen Unterführungen/Brücken vorbeizuleiten (siehe
# avoidHeightRestrictions() in src/lib/routing.ts). Bewusst KEINE
# Gewichtsprüfung, siehe Kommentar in src/lib/config.ts.
VEHICLE_HEIGHT_M=3.3

# --- Nominatim (Geocoding / Stadtteil-Ermittlung) ---
# Default: öffentlicher Demo-Server von Nominatim. Laut Nutzungsbedingungen
# max. 1 Anfrage/Sekunde, NUR für Tests / geringes Volumen gedacht
# (siehe https://operations.osmfoundation.org/policies/nominatim/).
# Für Dauerbetrieb: eigenen Docker-Container einrichten (siehe README)
# und hier auf http://localhost:8080 umstellen.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Pflichtangabe der öffentlichen Nominatim-Nutzungsbedingungen: eine
# gültige Kontakt-E-Mail-Adresse, falls der Betreiber euch bei zu hoher
# Last kontaktieren muss. Bei eigenem Nominatim-Server nicht relevant.
NOMINATIM_CONTACT_EMAIL=eure-email@example.com

# Optional: Suche auf ein Land beschränken (ISO-Code, verbessert Treffer)
NOMINATIM_COUNTRYCODES=de

# Optional: Bounding Box "min_lon,min_lat,max_lon,max_lat", um die Suche
# auf euer Einsatzgebiet einzugrenzen (leer lassen = keine Einschränkung).
# Standardmäßig auf München + Umland gesetzt - verhindert Mehrdeutigkeiten
# durch gleichnamige Straßen in anderen Städten (z. B. gibt es sowohl in
# München als auch in Düren eine "Waisenhausstraße") und beschleunigt die
# Kartenerstellung, da keine Rückfrage bei der Nutzerin/dem Nutzer nötig
# ist. Bei Bedarf an euer eigenes Einsatzgebiet anpassen.
NOMINATIM_VIEWBOX=11.35,48.05,11.75,48.25

# --- Datenbank & generierte Dateien (lokale Pfade, i.d.R. nicht ändern) ---
DB_PATH=./data/app.db
GENERATED_DIR=./public/generated

# --- Kartenausschnitt (Rückseite der Karte) ---
# Zoomstufe: höher = näher rangezoomt. 18 zeigt i.d.R. Hausnummern.
MAP_ZOOM=18
# Bildgröße in Pixeln (Seitenverhältnis passend zu A5 Querformat 210x148mm)
MAP_IMAGE_WIDTH=1490
MAP_IMAGE_HEIGHT=1050
# Länge (Meter) des im Kartenausschnitt hervorgehobenen letzten
# Streckenabschnitts vor dem Ziel.
MAP_LAST_SEGMENT_METERS=400
# Vector-Tile-Style (OpenMapTiles-Schema). Standard: OpenFreeMap (kostenlos,
# kein API-Key nötig, siehe https://openfreemap.org). Für Dauerbetrieb mit
# vielen Karten könnt ihr hier einen eigenen OpenMapTiles-kompatiblen
# Tile-Server eintragen.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Nur für Selbst-Hosting auf eigener Hardware (docker-compose.prod.yml) ---
# Die öffentlich erreichbare Domain eurer App, z. B.
# einsatzkarten.eure-domain.de - wird vom Caddy-Reverse-Proxy für das
# automatische HTTPS-Zertifikat gebraucht. Siehe DEPLOY_NUC.md.
DOMAIN=einsatzkarten.eure-domain.de
