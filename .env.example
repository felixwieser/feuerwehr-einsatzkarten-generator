# Kopiere diese Datei zu ".env" und trage eure echten Werte ein:
#   cp .env.example .env

# --- Anthropic Claude API (Pflicht) ---
# API-Key erhaltet ihr unter https://console.anthropic.com/ (Account
# anlegen -> "API Keys" -> "Create Key"). Achtung: dort muss zusätzlich
# Guthaben/eine Zahlungsmethode hinterlegt sein, siehe README.
ANTHROPIC_API_KEY=sk-ant-hier-euren-key-eintragen

# Welches Claude-Modell für die Anfahrtsbeschreibung genutzt wird.
# Modellnamen ändern sich mit der Zeit - prüft im Zweifel die aktuell
# gültigen Modellnamen unter https://docs.anthropic.com/ (Stichwort
# "Models"). Der hier hinterlegte Wert war zum Erstellungszeitpunkt aktuell.
ANTHROPIC_MODEL=claude-sonnet-5

# --- OSRM (Routing) ---
# Default: öffentlicher Demo-Server von OSRM. NUR für Tests / geringes
# Volumen gedacht (siehe https://project-osrm.org/ - "Demo server").
# Für Dauerbetrieb: eigenen Docker-Container einrichten (siehe README)
# und hier auf http://localhost:5000 umstellen.
OSRM_URL=https://router.project-osrm.org

# --- Nominatim (Geocoding / Stadtteil-Ermittlung) ---
# Default: öffentlicher Demo-Server von Nominatim. Laut Nutzungsbedingungen
# max. 1 Anfrage/Sekunde, NUR für Tests / geringes Volumen gedacht
# (siehe https://operations.osmfoundation.org/policies/nominatim/).
# Für Dauerbetrieb: eigenen Docker-Container einrichten (siehe README)
# und hier auf http://localhost:8080 umstellen.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Pflichtangabe der öffentlichen Nominatim-Nutzungsbedingungen: eine
# gültige Kontakt-E-Mail-Adresse, falls der Betreiber euch bei zu hoher
# Last kontaktieren muss. Bei eigenem Nominatim-Server nicht relevant.
NOMINATIM_CONTACT_EMAIL=eure-email@example.com

# Optional: Suche auf ein Land beschränken (ISO-Code, verbessert Treffer)
NOMINATIM_COUNTRYCODES=de

# Optional: Bounding Box "min_lon,min_lat,max_lon,max_lat", um die Suche
# auf euer Einsatzgebiet einzugrenzen (leer lassen = keine Einschränkung)
NOMINATIM_VIEWBOX=

# --- Datenbank & generierte Dateien (lokale Pfade, i.d.R. nicht ändern) ---
DB_PATH=./data/app.db
GENERATED_DIR=./public/generated

# --- Kartenausschnitt (Rückseite der Karte) ---
# Zoomstufe: höher = näher rangezoomt. 18 zeigt i.d.R. Hausnummern.
MAP_ZOOM=18
# Bildgröße in Pixeln (Seitenverhältnis passend zu A5 Querformat 210x148mm)
MAP_IMAGE_WIDTH=1490
MAP_IMAGE_HEIGHT=1050
# Vector-Tile-Style (OpenMapTiles-Schema). Standard: OpenFreeMap (kostenlos,
# kein API-Key nötig, siehe https://openfreemap.org). Für Dauerbetrieb mit
# vielen Karten könnt ihr hier einen eigenen OpenMapTiles-kompatiblen
# Tile-Server eintragen.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Nur für Selbst-Hosting auf eigener Hardware (docker-compose.prod.yml) ---
# Die öffentlich erreichbare Domain eurer App, z. B.
# einsatzkarten.eure-domain.de - wird vom Caddy-Reverse-Proxy für das
# automatische HTTPS-Zertifikat gebraucht. Siehe DEPLOY_NUC.md.
DOMAIN=einsatzkarten.eure-domain.de
